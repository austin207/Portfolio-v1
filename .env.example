# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Gmail OAuth2 (for contact form)
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable Gmail API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Set redirect URI to http://localhost:3000
# 5. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#    to generate a refresh token with scope: https://mail.google.com/
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER=austinantony06@gmail.com
GMAIL_RECEIVER=austinantony06@gmail.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Search engine verification (optional — omit and no meta tag is emitted)
# Google: Search Console -> Add property -> HTML tag -> copy the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools -> Add site -> HTML Meta Tag -> copy the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Groq API (ghost avatar chat — free at console.groq.com, no credit card)
GROQ_API_KEY=gsk_...
